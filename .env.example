SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=
# Browser origins allowed to call the API (comma-separated), or * for any
CORS_ORIGINS=*
# Host port the API is published on (8000 production, 8001 staging)
APP_PORT=8000
# Password for the bundled Postgres container (generate with: openssl rand -hex 24).
# Use letters and digits only; it is placed inside the database URL.
POSTGRES_PASSWORD=change-me
# Defaults to the bundled Postgres container; set to use another database
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Outgoing email for password reset codes. Without SMTP_HOST, reset emails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Duel Domain <no-reply@duel-domain.com>
SMTP_USE_TLS=True
