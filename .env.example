SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=
# Host port the API is published on (8000 production, 8001 staging)
APP_PORT=8000
# Defaults to the SQLite file in the container's data volume
# DATABASE_URL=sqlite+aiosqlite:////app/data/db.sqlite3

# Outgoing email for password reset codes. Without SMTP_HOST, reset emails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Duel Domain <no-reply@dueldomain.com>
SMTP_USE_TLS=True
