SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=
# Browser origins allowed to call the API (comma-separated), or * for any
CORS_ORIGINS=*
# Host port the API is published on (8000 production, 8001 staging)
APP_PORT=8000
# Password for the bundled Postgres container (generate with: openssl rand -hex 24).
# Use letters and digits only; it is placed inside the database URL.
POSTGRES_PASSWORD=change-me
# Defaults to the bundled Postgres container; set to use another database
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Email (verification, welcome, password codes, signup alerts) is sent through Resend.
# Without RESEND_API_KEY nothing is sent. MAIL_FROM's domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=duel@duel-domain.com
MAIL_FROM_NAME=Duel Domain
MAIL_REPLY_TO=support@duel-domain.com
# If the host blocks outgoing port 587, use 2587 (or 465/2465 for implicit TLS)
MAIL_PORT=587
# Comma-separated addresses notified of each new signup
ADMIN_NOTIFY_EMAILS=
FRONTEND_URL=https://duel-domain.com
